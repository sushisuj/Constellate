# Required. Get one at https://build.nvidia.com -> profile icon -> API Keys.
# Without it, app/llm.py falls back to the offline stub -- retrieval still
# works, but answers aren't LLM-composed.
NVIDIA_API_KEY=nvapi-...

# Model is meta/llama-3.1-8b-instruct, hardcoded in app/config.py, not an
# env var -- see that file's comment for why (a reasoning model here costs
# 43-400+s per response instead of under 15s).
